---
import { readFile } from 'node:fs/promises'

// generated by /get-repo-data.ts
const spFile = 'sponsors.json'

type Sponsor = {id: number, username: string}
type Data = {sponsors: Sponsor[], backers: Sponsor[], private: number}

const data: Data = JSON.parse(await readFile(spFile, 'utf-8'))
---

<center>
<h5>Sponsors</h5>

<div class="sponsors">
    {data.sponsors.map(s => <a class="sponsor" href={'https://github.com/' + s.username}>
        <img src={`https://avatars.githubusercontent.com/u/${s.id}?v=4&s=96`} />
    </a>)}
</div>

<p>Become a sponsor and get your name or logo listed here!</p>

<p>
    <a href="https://github.com/sponsors/K1DV5">
        <img alt="Sponsor on GitHub" src="https://img.shields.io/badge/Sponsor%20on-GitHub-%23ea4aaa?logo=github&logoColor=white" />
    </a>
</p>

</center>

<style>

.sponsors {
    display: flex;
    justify-content: center;
}

.sponsor {
    margin: .3em;
}

</style>
